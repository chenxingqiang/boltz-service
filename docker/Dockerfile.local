# Local/Kind CPU deployment image
FROM docker.m.daocloud.io/library/python:3.10-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/app/src
ENV BOLTZ_CACHE_DIR=/data/cache
ENV HF_ENDPOINT=https://hf-mirror.com

RUN apt-get update && apt-get install -y --no-install-recommends \
    wget curl build-essential libxrender1 libxext6 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml setup.py requirements.txt README.md ./
COPY src ./src/
COPY scripts/k8s/bootstrap-model.sh /usr/local/bin/bootstrap-model.sh

RUN chmod +x /usr/local/bin/bootstrap-model.sh && \
    pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir -e .

RUN mkdir -p /opt/model /data/cache/models/v1

EXPOSE 50051

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=5 \
  CMD python -c "import grpc; c=grpc.insecure_channel('127.0.0.1:50051'); grpc.channel_ready_future(c).result(timeout=5)" || exit 1

CMD ["python", "-m", "boltz_service.main", "serve", "--host", "0.0.0.0", "--port", "50051", "--cache", "/data/cache", "--accelerator", "cpu", "--devices", "1", "--workers", "2"]
